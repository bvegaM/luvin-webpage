# Envío de los correos de la lista de espera por SMTP. Por defecto, Gmail.
# Sin SMTP_USER y SMTP_PASS, el formulario avisa que la lista abre pronto y no se envía nada.

# Tu cuenta de Gmail.
SMTP_USER=
# Contraseña de aplicación de Google (16 letras), NO tu contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
SMTP_PASS=

# Nombre visible del remitente.
WAITLIST_FROM_NAME=Luvin
# Opcional: a dónde llega el aviso de cada registro nuevo. Por defecto, la misma cuenta de SMTP_USER.
WAITLIST_NOTIFY_TO=

# Para otro proveedor (Resend, Brevo, Mailjet...) cuando tengas dominio propio:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# WAITLIST_FROM=hola@luvin.dev
